# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code local config (contains absolute paths, command history).
# Ignore the whole directory, not just the two files that happen to exist today —
# otherwise any newly-created .claude/ file (settings.json, agents/, commands/) is
# swept into the public repo by a single `git add -A`.
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Logs (large, reproducible by running main.py)
logs/

# Outputs (charts + JSON — reproducible)
outputs/

# Data cache (auto-refetched from yfinance if absent)
data/

# Internal dev backups, patches, status notes — not for the public repo
archive/

# Interview prep notes (local only)
GRILL_NOTES.md

# Environment
.env
*.env

# Coverage data
.coverage
htmlcov/
.ruff_cache/
